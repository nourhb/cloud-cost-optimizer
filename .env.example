# Cloud Cost Optimizer — environment variables
# Copy to .env.local and adjust. Never commit real secrets.

# --- Public (embedded in the browser bundle) ---

# Base URL of the app (used for absolute links / redirects)
# Public
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Demo mode hint when no Supabase URL/anon key is configured (env or Settings UI).
# When Supabase is configured (env OR Settings cookie), the app uses live Auth + Postgres.
# Public
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project URL — optional if you paste URL/anon in Settings UI instead
# Public
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — RLS-enforced; never use the service_role key here
# Public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secret / server-only (never use NEXT_PUBLIC_ prefix) ---

# Supabase service role key — SERVER ONLY. Bypasses RLS.
# Must NEVER be prefixed with NEXT_PUBLIC_.
# Optional for MVP: user CRUD uses the anon key + session + RLS.
# Secret
SUPABASE_SERVICE_ROLE_KEY=

# Max CSV upload size in bytes (default: 5 MiB)
# Server
CSV_MAX_BYTES=5242880

# Max CSV rows accepted per import (default: 50_000)
# Server
CSV_MAX_ROWS=50000
